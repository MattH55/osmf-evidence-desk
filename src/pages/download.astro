---
/**
 * Dump download page (ED-15).
 * Shows ingested meta + how Desk obtains the graph dump at build time.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMeta } from '../lib/dump';

const meta = getMeta();
const graphRepo = 'https://github.com/MattH55/osmf-evidence-graph';
const schemaUrl =
  'https://github.com/MattH55/osmf-evidence-graph/blob/main/SCHEMA.md';
const schemaRaw =
  'https://raw.githubusercontent.com/MattH55/osmf-evidence-graph/main/SCHEMA.md';
---

<BaseLayout
  title="Download — Evidence Desk"
  description="Evidence dump metadata and how Desk obtains the Shared Evidence Graph dump."
>
  <h1 class="page-title">Evidence dump</h1>
  <p class="lede">
    Desk ingests a Shared Evidence Graph dump at <strong>build time</strong> via
    <code>npm run fetch-dump</code>. The dump is
    <strong>vendored/generated for each build</strong> — not a permanent public
    graph CDN URL yet. When EG-8 publishes a stable artifact, this page will
    prefer that URL.
  </p>

  <aside class="download-vendored" role="note">
    <p class="download-vendored__title">Vendored at build</p>
    <p class="download-vendored__body">
      <code>fetch-dump</code> clones
      <a href={graphRepo}>MattH55/osmf-evidence-graph</a>,
      runs <code>build:dump</code>, and copies
      <code>dist/dump/latest.json</code> into this site’s
      <code>data/dump/latest.json</code>. A copy is also published under
      <a href="/dump/latest.json"><code>/dump/latest.json</code></a>
      for this build so the JSON is fetchable from the Desk host.
    </p>
  </aside>

  <section class="download-meta" aria-labelledby="dump-meta-heading">
    <h2 id="dump-meta-heading" class="section-title">This build’s dump meta</h2>
    <dl class="meta-grid">
      <div class="meta-grid__row">
        <dt>schema_version</dt>
        <dd><code>{meta.schema_version}</code></dd>
      </div>
      <div class="meta-grid__row">
        <dt>generated_at</dt>
        <dd><time datetime={meta.generated_at}>{meta.generated_at}</time></dd>
      </div>
      <div class="meta-grid__row">
        <dt>is_example</dt>
        <dd><code>{String(meta.is_example)}</code></dd>
      </div>
      <div class="meta-grid__row">
        <dt>publisher</dt>
        <dd>{meta.publisher}</dd>
      </div>
      <div class="meta-grid__row">
        <dt>license</dt>
        <dd>{meta.license}</dd>
      </div>
      {
        meta.notes ? (
          <div class="meta-grid__row">
            <dt>notes</dt>
            <dd>{meta.notes}</dd>
          </div>
        ) : null
      }
    </dl>
  </section>

  <section aria-labelledby="get-dump-heading">
    <h2 id="get-dump-heading" class="section-title">Get the dump</h2>
    <ul class="download-actions">
      <li>
        <a class="btn btn--primary" href="/dump/latest.json" download="latest.json">
          Download this build’s dump JSON
        </a>
      </li>
      <li>
        <a class="btn btn--secondary" href={graphRepo}>
          Evidence graph repository
        </a>
      </li>
      <li>
        <a class="btn btn--secondary" href={schemaUrl}>
          SCHEMA.md
        </a>
        <span class="download-actions__alt">
          (<a href={schemaRaw}>raw</a>)
        </span>
      </li>
    </ul>
    <ol class="download-steps">
      <li>
        Clone or update
        <a href={graphRepo}>MattH55/osmf-evidence-graph</a>
        and run <code>npm run build:dump</code> there, <strong>or</strong>
      </li>
      <li>
        From this Desk repo run <code>npm run fetch-dump</code> (clones the graph
        cache, builds the dump, copies to <code>data/dump/latest.json</code> and
        <code>public/dump/latest.json</code>).
      </li>
    </ol>
  </section>

  <p class="entity-footer-nav">
    <a href="/">← Home</a>
    ·
    <a href="/search">Search</a>
    ·
    <a href="/about">About</a>
  </p>
</BaseLayout>
