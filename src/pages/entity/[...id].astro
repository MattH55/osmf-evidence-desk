---
/**
 * Entity desk view (ED-4).
 * One static page per dump entity. Unknown ids 404 (no path generated).
 * URL: /entity/osmf/condition/pacvs ↔ osmf:condition:pacvs
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClaimCard from '../../components/ClaimCard.astro';
import TierLegend from '../../components/TierLegend.astro';
import {
  getAllEntities,
  getClaimsForEntity,
  getEntity,
  getEntityLabel,
  getRelatedEntities,
  type DumpClaim,
  type DumpEntity,
  type EvidenceTier,
  type ClaimStatus,
} from '../../lib/dump';
import { claimHref, entityHref, entityIdToPath } from '../../lib/ids';

export function getStaticPaths() {
  return getAllEntities().map((entity) => ({
    params: { id: entityIdToPath(entity.id) },
    props: { entity },
  }));
}

interface Props {
  entity: DumpEntity;
}

const { entity } = Astro.props;
// Unknown IDs are not in getStaticPaths → natural static 404.
// ID ↔ path via entityIdToPath / pathPartsToEntityId in src/lib/ids.ts.
const claims = getClaimsForEntity(entity.id);
const related = getRelatedEntities(entity.id);

const aliases = Array.isArray(entity.aliases) ? entity.aliases : [];
const externalIds = Array.isArray(entity.external_ids) ? entity.external_ids : [];
const urls = Array.isArray(entity.urls) ? entity.urls : [];

function isTier(t: string): t is EvidenceTier {
  return t === 'A' || t === 'B' || t === 'C' || t === 'D';
}

function isStatus(s: string): s is ClaimStatus {
  return s === 'draft' || s === 'published' || s === 'superseded';
}

function claimCardProps(claim: DumpClaim) {
  const tierRaw = String(claim.evidence_tier ?? 'D');
  const statusRaw = String(claim.status ?? 'draft');
  const tier: EvidenceTier = isTier(tierRaw) ? tierRaw : 'D';
  const status: ClaimStatus = isStatus(statusRaw) ? statusRaw : 'draft';

  const subjectEntity = getEntity(claim.subject_id);
  const objectId = claim.object_id;
  const objectLiteral =
    typeof claim.object_literal === 'string' ? claim.object_literal : undefined;
  const objectEntity = objectId ? getEntity(objectId) : undefined;
  const objectLabel = objectLiteral
    ? objectLiteral
    : objectId
      ? getEntityLabel(objectId)
      : undefined;

  return {
    id: claim.id,
    claimHref: claimHref(claim.id),
    tier,
    status,
    sources: claim.sources ?? [],
    limitations: claim.limitations,
    reviewed_at: claim.reviewed_at,
    subjectLabel: getEntityLabel(claim.subject_id),
    subjectHref: subjectEntity ? entityHref(subjectEntity.id) : undefined,
    predicate: claim.predicate,
    objectLabel,
    objectHref: objectEntity ? entityHref(objectEntity.id) : undefined,
  };
}

function formatWhen(iso?: string): string | undefined {
  if (!iso) return undefined;
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return iso;
  return d.toISOString().slice(0, 10);
}

const updatedLabel = formatWhen(entity.updated_at);
const pageTitle = `${entity.label} — Evidence Desk`;
const description =
  entity.summary?.slice(0, 160) ||
  `${entity.type} entity ${entity.id} in the OSMF Shared Evidence Graph.`;
---

<BaseLayout title={pageTitle} description={description}>
  <nav class="entity-breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a>
    <span aria-hidden="true"> / </span>
    <span>Entity</span>
  </nav>

  <header class="entity-header">
    <p class="entity-type">
      <span class="entity-type__label">{entity.type}</span>
      {
        entity.status && (
          <span class="entity-status">status: {entity.status}</span>
        )
      }
    </p>
    <h1 class="page-title entity-title">{entity.label}</h1>
    <p class="entity-id">
      <code>{entity.id}</code>
      {
        updatedLabel && entity.updated_at && (
          <span class="entity-updated">
            Updated{' '}
            <time datetime={entity.updated_at}>{updatedLabel}</time>
          </span>
        )
      }
    </p>
  </header>

  {
    entity.summary && (
      <section class="entity-section" aria-labelledby="entity-summary-heading">
        <h2 id="entity-summary-heading" class="section-title">Summary</h2>
        <p class="entity-summary">{entity.summary}</p>
      </section>
    )
  }

  {
    aliases.length > 0 && (
      <section class="entity-section" aria-labelledby="entity-aliases-heading">
        <h2 id="entity-aliases-heading" class="section-title">Aliases</h2>
        <ul class="entity-chip-list">
          {aliases.map((a) => (
            <li>
              <span class="entity-chip">{a}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    externalIds.length > 0 && (
      <section class="entity-section" aria-labelledby="entity-extids-heading">
        <h2 id="entity-extids-heading" class="section-title">External IDs</h2>
        <ul class="entity-kv-list">
          {externalIds.map((x) => (
            <li>
              <span class="entity-kv__key">{x.system}</span>
              <code class="entity-kv__value">{x.value}</code>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    urls.length > 0 && (
      <section class="entity-section" aria-labelledby="entity-urls-heading">
        <h2 id="entity-urls-heading" class="section-title">Network links</h2>
        <ul class="entity-url-list">
          {urls.map((u) => (
            <li>
              <a href={u.href} rel="noopener noreferrer">
                {u.rel}
              </a>
              <span class="entity-url-list__href">{u.href}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="entity-section" aria-labelledby="entity-claims-out-heading">
    <h2 id="entity-claims-out-heading" class="section-title">
      Claims out
      <span class="section-count">({claims.out.filter((c) => c.status !== 'superseded').length})</span>
    </h2>
    <p class="section-note">
      Claims where this entity is the <strong>subject</strong> (non-superseded).
    </p>
    {
      claims.out.filter((c) => c.status !== 'superseded').length === 0 ? (
        <p class="entity-empty">No outbound claims.</p>
      ) : (
        <div class="entity-claim-list">
          {claims.out
            .filter((c) => c.status !== 'superseded')
            .map((c) => (
              <ClaimCard {...claimCardProps(c)} />
            ))}
        </div>
      )
    }
  </section>

  <section class="entity-section" aria-labelledby="entity-claims-in-heading">
    <h2 id="entity-claims-in-heading" class="section-title">
      Claims in
      <span class="section-count">({claims.in.filter((c) => c.status !== 'superseded').length})</span>
    </h2>
    <p class="section-note">
      Claims where this entity is the <strong>object</strong> (non-superseded).
    </p>
    {
      claims.in.filter((c) => c.status !== 'superseded').length === 0 ? (
        <p class="entity-empty">No inbound claims.</p>
      ) : (
        <div class="entity-claim-list">
          {claims.in
            .filter((c) => c.status !== 'superseded')
            .map((c) => (
              <ClaimCard {...claimCardProps(c)} />
            ))}
        </div>
      )
    }
  </section>

  {
    claims.superseded.length > 0 && (
      <section class="entity-section" aria-labelledby="entity-history-heading">
        <h2 id="entity-history-heading" class="section-title">History</h2>
        <details class="entity-history">
          <summary>
            History / superseded ({claims.superseded.length})
          </summary>
          <div class="entity-claim-list entity-claim-list--history">
            {claims.superseded.map((c) => (
              <ClaimCard {...claimCardProps(c)} />
            ))}
          </div>
        </details>
      </section>
    )
  }

  <section class="entity-section" aria-labelledby="entity-related-heading">
    <h2 id="entity-related-heading" class="section-title">
      Related entities
      <span class="section-count">({related.length})</span>
    </h2>
    <p class="section-note">One-hop neighbors via claims (unique dump entities).</p>
    {
      related.length === 0 ? (
        <p class="entity-empty">No related entities in this dump.</p>
      ) : (
        <ul class="seed-list entity-related-list">
          {related.map((r) => (
            <li>
              <a class="seed-list__label" href={entityHref(r.id)}>
                {r.label}
              </a>
              <span class="entity-related-type">{r.type}</span>
              <code class="seed-list__id">{r.id}</code>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <TierLegend />

  <p>
    <a href="/">← Back to home</a>
  </p>
</BaseLayout>
