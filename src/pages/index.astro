---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMeta, getSeedConditions } from '../lib/dump';
import { entityHref } from '../lib/ids';

const meta = getMeta();
const seedConditions = getSeedConditions();
---

<BaseLayout
  title="Evidence Desk"
  description="Browse seed conditions and claims from the OSMF Shared Evidence Graph. Not medical advice."
>
  <section class="home-hero" aria-labelledby="home-heading">
    <h1 class="page-title" id="home-heading">Evidence Desk</h1>
    <p class="lede">
      A search-and-browse UI for the
      <a href="https://github.com/MattH55/osmf-evidence-graph">OSMF Shared Evidence Graph</a>
      — conditions, biomarkers, agents, trials, papers, and claims with provenance
      and evidence tiers.
    </p>
    <p class="home-policy">
      <strong>Not medical advice.</strong> Desk surfaces structured research for
      exploration and transparency. It is not diagnosis, treatment guidance, or a
      substitute for clinical care. See <a href="/about">About</a> for tiers,
      citation, and license.
    </p>
    <div class="home-cta">
      <a class="btn btn--primary" href="/search">Search entities</a>
      <a class="btn btn--secondary" href="/about">About / cite</a>
      <a class="btn btn--secondary" href="/download">Dump info</a>
    </div>
    <p class="home-meta">
      Schema <code>{meta.schema_version}</code>
      · generated <time datetime={meta.generated_at}>{meta.generated_at}</time>
      · license {meta.license}
    </p>
  </section>

  <section class="seed-conditions" aria-labelledby="seed-conditions-heading">
    <h2 id="seed-conditions-heading" class="section-title">Featured seed conditions</h2>
    <p class="section-note">
      From <code>meta.seed_conditions</code> in the build-time dump. Each link
      opens the entity desk view (<code>/entity/…</code>).
    </p>
    {
      seedConditions.length === 0 ? (
        <p>No <code>meta.seed_conditions</code> in the dump.</p>
      ) : (
        <ul class="seed-list">
          {seedConditions.map((c) => (
            <li>
              <a class="seed-list__label" href={entityHref(c.id)}>
                {c.label}
              </a>
              <code class="seed-list__id">{c.id}</code>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
