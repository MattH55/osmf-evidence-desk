---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getMeta, getSeedConditions } from '../lib/dump';

const meta = getMeta();
const seedConditions = getSeedConditions();
---

<BaseLayout
  title="Evidence Desk"
  description="Browse seed conditions and claims from the OSMF Shared Evidence Graph."
>
  <h1 class="page-title">Evidence Desk</h1>
  <p class="lede">
    Search-and-browse UI for the OSMF Shared Evidence Graph. Seed conditions
    below come from the build-time dump
    (<code>meta.schema_version</code> {meta.schema_version}).
  </p>

  <section class="seed-conditions" aria-labelledby="seed-conditions-heading">
    <h2 id="seed-conditions-heading" class="section-title">Seed conditions</h2>
    <p class="section-note">
      Entity detail pages land in ED-4. Labels and ids are listed here from the
      dump without placeholder routes that would 404.
    </p>
    {
      seedConditions.length === 0 ? (
        <p>No <code>meta.seed_conditions</code> in the dump.</p>
      ) : (
        <ul class="seed-list">
          {seedConditions.map((c) => (
            <li>
              <span class="seed-list__label">{c.label}</span>
              <code class="seed-list__id">{c.id}</code>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <p>
    See <a href="/about">About</a> for soft-launch / example-data policy and the
    not-medical-advice notice.
  </p>
</BaseLayout>
