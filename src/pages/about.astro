---
import BaseLayout from '../layouts/BaseLayout.astro';
import TierLegend from '../components/TierLegend.astro';
import { getMeta, getSeedConditions } from '../lib/dump';
import { buildCiteSnippet } from '../lib/export';
import { entityHref } from '../lib/ids';

const meta = getMeta();
const seeds = getSeedConditions();
const citeEntity = seeds[0] ?? {
  id: 'osmf:condition:long-covid',
  label: 'Long COVID',
  type: 'condition',
};
const citePath = entityHref(citeEntity.id);
const citeUrl = `https://desk.opensourcemed.info${citePath}`;
const generatedDate = meta.generated_at.slice(0, 10);
const citeSnippet = buildCiteSnippet({
  entityId: citeEntity.id,
  deskUrl: citeUrl,
  meta,
});
---

<BaseLayout
  title="About — Evidence Desk"
  description="About Evidence Desk: not medical advice, evidence tiers, how to cite, and license."
>
  <h1 class="page-title">About</h1>
  <p class="lede">
    Evidence Desk is a search-and-browse UI for the
    <a href="https://github.com/MattH55/osmf-evidence-graph"
      >OSMF Shared Evidence Graph</a
    >
    — conditions, biomarkers, agents, trials, papers, and claims with provenance
    and evidence tiers.
  </p>

  <section aria-labelledby="not-advice-heading">
    <h2 id="not-advice-heading" class="section-title">Not medical advice</h2>
    <p>
      <strong>Content on Evidence Desk is not medical advice.</strong> It is not
      a diagnosis, prescription, dosing guide, or treatment recommendation. Desk
      exists for research exploration, transparency, and reproducibility of
      structured claims. Always consult a qualified clinician for personal health
      decisions.
    </p>
    <p>
      {
        meta.is_example ? (
          <>
            This build uses <strong>illustrative / example</strong> dump data
            (<code>meta.is_example: true</code>). A persistent banner appears on
            every page until curated claims ship and the dump flag is cleared.
          </>
        ) : (
          <>
            This build uses curated dump data (
            <code>meta.is_example: false</code>).
          </>
        )
      }
    </p>
  </section>

  <TierLegend />
  <p class="section-note">
    Tier wording matches
    <a
      href="https://raw.githubusercontent.com/MattH55/osmf-evidence-graph/main/SCHEMA.md"
      >evidence-graph <code>SCHEMA.md</code></a
    >
    (Evidence tiers A–D). Source repo:
    <a href="https://github.com/MattH55/osmf-evidence-graph"
      >github.com/MattH55/osmf-evidence-graph</a
    >.
  </p>

  <section aria-labelledby="cite-heading">
    <h2 id="cite-heading" class="section-title">How to cite</h2>
    <p>
      Cite the graph entity id, the Desk URL path for that entity, and the dump
      <code>generated_at</code> timestamp so readers can align with a specific
      build.
    </p>
    <p class="cite-example-label">Prose example (entity + dump date):</p>
    <blockquote class="cite-example">
      <p>
        Open Source Medicine Foundation. {citeEntity.label} (
        <code>{citeEntity.id}</code>). <em>Evidence Desk</em>.
        <a href={citePath}>{citeUrl}</a>. Dump generated{' '}
        <time datetime={meta.generated_at}>{meta.generated_at}</time>
        {' '}(schema {meta.schema_version}; accessed {generatedDate}). License:{' '}
        {meta.license}.
      </p>
    </blockquote>
    <p class="cite-example-label" id="cite-snippet-format">
      Copy-citation snippet format (ED-11)
    </p>
    <p>
      Entity pages expose a <strong>Copy citation</strong> button that places four
      lines on the clipboard: graph id, absolute Desk URL, dump
      <code>generated_at</code>, and <code>schema_version</code>.
    </p>
    <pre class="cite-snippet" tabindex="0"><code>{citeSnippet}</code></pre>
    <p class="section-note">
      Prefer the entity id over display labels when linking programmatically.
      Claim pages use the same pattern under <code>/claim/…</code>.
    </p>
  </section>

  <section aria-labelledby="exports-heading" id="exports">
    <h2 id="exports-heading" class="section-title">Exports (CSV &amp; BibTeX)</h2>
    <p>
      Each entity page can download a <strong>CSV</strong> of claims that involve
      that entity (subject or object) and a <strong>BibTeX</strong> file built from
      claim sources. Both run in the browser from page data — no account required.
    </p>
    <p class="cite-example-label">CSV columns (stable)</p>
    <p>
      <code>id</code>, <code>subject</code>, <code>predicate</code>,
      <code>object</code>, <code>tier</code>, <code>sources</code>,
      <code>reviewed_at</code>, <code>status</code>.
    </p>
    <p class="cite-example-label">BibTeX limitations</p>
    <ul>
      <li>
        <strong>DOI</strong> and <strong>PMID</strong> sources become usable
        <code>@article</code> entries (<code>doi</code> / PubMed
        <code>eprint</code>).
      </li>
      <li>
        <strong>NCT</strong> trial ids become <code>@misc</code> entries when
        present.
      </li>
      <li>
        <strong>url</strong> and <strong>osmf_page</strong> sources are
        <em>omitted</em> from the .bib file — they are not full bibliographic
        records (often hub pages or tracker URLs without title/author/year). Prefer
        attaching a DOI or PMID on the claim when you need citability.
      </li>
    </ul>
  </section>

  <section aria-labelledby="license-heading">
    <h2 id="license-heading" class="section-title">License</h2>
    <p>
      Dump content in this build is licensed as declared in meta:
      <strong>{meta.license}</strong>
      {
        meta.license === 'CC-BY-4.0' ? (
          <>
            {' '}
            (
            <a href="https://creativecommons.org/licenses/by/4.0/"
              >Creative Commons Attribution 4.0</a
            >
            ).
          </>
        ) : (
          '.'
        )
      }
      {' '}
      Publisher: {meta.publisher}. Product decisions (host, dump source,
      soft-launch policy) are recorded in
      <a
        href="https://github.com/MattH55/osmf-evidence-desk/blob/main/DECISIONS.md"
        >DECISIONS.md</a
      >.
    </p>
  </section>

  <section aria-labelledby="links-heading">
    <h2 id="links-heading" class="section-title">Links</h2>
    <ul>
      <li>
        <a href="https://github.com/MattH55/osmf-evidence-graph"
          >Shared Evidence Graph repository</a
        >
      </li>
      <li>
        <a
          href="https://raw.githubusercontent.com/MattH55/osmf-evidence-graph/main/SCHEMA.md"
          >SCHEMA.md (raw)</a
        >
      </li>
      <li>
        <a href="/download">Dump meta &amp; fetch instructions</a>
      </li>
      <li>
        <a href="/search">Entity search (MiniSearch)</a>
      </li>
      <li>
        <a href="https://github.com/MattH55/osmf-evidence-desk"
          >Evidence Desk repository</a
        >
      </li>
    </ul>
  </section>

  <p>
    <a href="/">← Home</a>
  </p>
</BaseLayout>
