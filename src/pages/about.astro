---
import BaseLayout from '../layouts/BaseLayout.astro';
import TierLegend from '../components/TierLegend.astro';
import { getMeta } from '../lib/dump';

const meta = getMeta();
---

<BaseLayout
  title="About — Evidence Desk"
  description="About Evidence Desk: scope, evidence tiers, example data, and not medical advice."
>
  <h1 class="page-title">About</h1>
  <p class="lede">
    Evidence Desk is a search-and-browse UI for the OSMF Shared Evidence Graph —
    conditions, biomarkers, agents, trials, papers, and claims with provenance
    and evidence tiers.
  </p>
  <p>
    <strong>Not medical advice.</strong> Content here is for research exploration
    and transparency. It is not a substitute for professional medical judgment,
    diagnosis, or treatment.
  </p>
  <p>
    {
      meta.is_example ? (
        <>
          This build uses <strong>illustrative / example</strong> dump data
          (<code>meta.is_example: true</code>). A persistent banner appears on
          every page until curated claims ship and the dump flag is cleared.
        </>
      ) : (
        <>
          This build uses curated dump data (<code>meta.is_example: false</code>
          ).
        </>
      )
    }
    {' '}
    Publisher: {meta.publisher}. License: {meta.license}. Product decisions
    (host, dump source, soft-launch policy) are recorded in
    <a href="https://github.com/MattH55/osmf-evidence-desk/blob/main/DECISIONS.md"
      >DECISIONS.md</a
    >.
  </p>

  <TierLegend />

  <p>
    <a href="/">← Back to home</a>
  </p>
</BaseLayout>
