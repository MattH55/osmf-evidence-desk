---
/**
 * Entity page export actions (ED-9 / ED-10 / ED-11).
 * Server builds CSV / BibTeX / cite snippet; client Blob-downloads or copies.
 */
interface Props {
  entityId: string;
  csvText: string;
  bibtexText: string;
  citeSnippet: string;
  /** Optional note shown near BibTeX button. */
  bibtexNote?: string;
  claimCount: number;
  bibtexEntryCount: number;
}

const {
  entityId,
  csvText,
  bibtexText,
  citeSnippet,
  bibtexNote = 'BibTeX includes DOI/PMID (and NCT when present). url / osmf_page sources are omitted — see About.',
  claimCount,
  bibtexEntryCount,
} = Astro.props;

const basename = entityId.replace(/[^a-zA-Z0-9._-]+/g, '-').replace(/^-+|-+$/g, '') || 'entity';
const csvFilename = `${basename}-claims.csv`;
const bibFilename = `${basename}-sources.bib`;
---

<section class="entity-export" aria-labelledby="entity-export-heading" data-entity-export>
  <h2 id="entity-export-heading" class="section-title">Export &amp; cite</h2>
  <p class="section-note">
    Downloads are generated in your browser from this page’s dump data (no login).
    CSV covers {claimCount} claim{claimCount === 1 ? '' : 's'} involving this entity.
    BibTeX has {bibtexEntryCount} entr{bibtexEntryCount === 1 ? 'y' : 'ies'}.
  </p>
  <div class="entity-export__actions" role="group" aria-label="Export actions">
    <button
      type="button"
      class="btn btn--secondary"
      data-export="csv"
      data-filename={csvFilename}
    >
      Download CSV
    </button>
    <button
      type="button"
      class="btn btn--secondary"
      data-export="bibtex"
      data-filename={bibFilename}
      aria-describedby="entity-export-bib-note"
    >
      Download BibTeX
    </button>
    <button type="button" class="btn btn--primary" data-export="cite">
      Copy citation
    </button>
  </div>
  <p class="entity-export__bib-note" id="entity-export-bib-note">
    {bibtexNote}
    {' '}
    <a href="/about#exports">About exports</a>
  </p>
  <p class="entity-export__status" data-export-status aria-live="polite"></p>
</section>

<script define:vars={{ csvText, bibtexText, citeSnippet }}>
  function downloadText(filename, text, mime) {
    const blob = new Blob([text], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.rel = 'noopener';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  async function copyText(text) {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch (_) {
      /* fall through */
    }
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'fixed';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      ta.remove();
      return ok;
    } catch (_) {
      return false;
    }
  }

  const root = document.querySelector('[data-entity-export]');
  if (root) {
    const statusEl = root.querySelector('[data-export-status]');
    const setStatus = (msg) => {
      if (statusEl) statusEl.textContent = msg;
    };

    root.querySelectorAll('[data-export]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const kind = btn.getAttribute('data-export');
        if (kind === 'csv') {
          const name = btn.getAttribute('data-filename') || 'claims.csv';
          downloadText(name, csvText, 'text/csv;charset=utf-8');
          setStatus('Downloaded ' + name);
          return;
        }
        if (kind === 'bibtex') {
          const name = btn.getAttribute('data-filename') || 'sources.bib';
          downloadText(name, bibtexText, 'application/x-bibtex;charset=utf-8');
          setStatus('Downloaded ' + name);
          return;
        }
        if (kind === 'cite') {
          const ok = await copyText(citeSnippet);
          setStatus(
            ok
              ? 'Citation copied to clipboard'
              : 'Could not copy — see citation format on /about',
          );
          if (ok) {
            const prev = btn.textContent;
            btn.textContent = 'Copied';
            window.setTimeout(() => {
              btn.textContent = prev || 'Copy citation';
            }, 1600);
          }
        }
      });
    });
  }
</script>
