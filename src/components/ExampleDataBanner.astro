---
/**
 * Persistent banner for illustrative / example dump data.
 * Driven from dump `meta.is_example` via BaseLayout (ED-2).
 */
interface Props {
  show?: boolean;
}

const { show = false } = Astro.props;
---

{
  show && (
    <aside class="example-banner" role="status" aria-live="polite">
      <div class="example-banner__inner">
        <span class="example-banner__label">Example data</span>
        <p class="example-banner__text">
          This view uses illustrative / example evidence data for UX validation.
          It is not curated clinical guidance. Soft-launch keeps this banner
          while <code>meta.is_example</code> is true.
        </p>
      </div>
    </aside>
  )
}
